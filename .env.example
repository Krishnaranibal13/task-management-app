# Task Management MVP — repository-root environment template
#
# This file feeds `docker-compose.yml` (local development stack).
# Copy it to `.env` in the repository root and adjust values.
# NEVER commit real secrets — `.env` is gitignored.
#
# All defaults below are non-secret LOCAL placeholders only.

# --- MySQL (local dev containers) -------------------------------------
# Required by compose (no fallback): choose local-only values.
MYSQL_ROOT_PASSWORD=change-me-local-only
MYSQL_PASSWORD=change-me-local-only

# Optional overrides (compose provides safe fallbacks):
MYSQL_DB=taskdb
MYSQL_USER=appuser

# Host-side published port for the dev MySQL container. The default
# avoids colliding with a native MySQL service that may already listen
# on 3306 on this machine. In-container port stays 3306.
MYSQL_HOST_PORT=33061

# NOTE: The login rate-limit threshold is intentionally NOT defined here.
# It has not been human-approved; it becomes configurable env
# configuration during the authentication phase.
