# Local development environment — backend
# Copy to `.env` and adjust. NEVER commit real secrets.
# These are placeholders for local development only.

ENVIRONMENT=local

# --- MySQL (local dev container) --------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=taskdb
MYSQL_USER=appuser
MYSQL_PASSWORD=change-me-local-only

# --- Backend HTTP -------------------------------------------------------
BACKEND_PORT=8000

# NOTE: No session/cookie or rate-limit variables are defined here.
# Cookie naming and the login rate-limit threshold have not been
# human-approved; they belong to the authentication/session phase.
