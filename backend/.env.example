# Local development environment — backend
# Copy to `.env` and adjust. NEVER commit real secrets.
# These are placeholders for local development only.

ENVIRONMENT=local

# --- MySQL (local dev container) --------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=taskdb
MYSQL_USER=appuser
MYSQL_PASSWORD=change-me-local-only

# --- Backend HTTP -------------------------------------------------------
BACKEND_PORT=8000

# Reserved for later phases (auth/session). Thresholds stay configurable;
# do not hardcode policy values elsewhere in the codebase.
SESSION_COOKIE_NAME=session
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
